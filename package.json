{
  "name": "bita-motos",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @bita-motos/api & npm run dev --workspace @bita-motos/web",
    "dev:api": "npm run dev --workspace @bita-motos/api",
    "dev:web": "npm run dev --workspace @bita-motos/web",
